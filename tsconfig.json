{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["bun", "vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["vendor"]
}
