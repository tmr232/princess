#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

bun_version=1.3.10
SECONDS=0
echo "Preparing orb toolchain (Bun $bun_version and Git)"
missing_packages=()
for package in git curl unzip; do
  if ! command -v "$package" >/dev/null 2>&1; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  apt-get update
  apt-get install -y "${missing_packages[@]}"
fi
if ! command -v bun >/dev/null 2>&1 || [[ "$(bun --version)" != "$bun_version" ]]; then
  # /usr/local/bin is available to subsequent Amp and service login shells.
  curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash -s -- "bun-v$bun_version"
fi
echo "Toolchain ready in ${SECONDS}s"

SECONDS=0
echo "Installing locked dependencies"
bun install --frozen-lockfile
echo "Dependencies ready in ${SECONDS}s"

SECONDS=0
echo "Building browser assets for the review CLI"
bun --bun run build
echo "Browser assets ready in ${SECONDS}s"
